# Copy to .env (or .env.local) and adjust. Only VITE_* variables reach the browser,
# and anything that reaches the browser is public — never put secrets here.

# Base URL of the Vendli API.
VITE_API_URL=https://your-api.example.com/api/

# Public URL the app is served from.
VITE_PUBLIC_APP_URL=http://localhost:8080

# true  = serve every request from the bundled demo data (src/mocks). No backend needed.
# false = call VITE_API_URL. Mock mode also switches on automatically when VITE_API_URL is empty.
VITE_USE_MOCK_API=true
